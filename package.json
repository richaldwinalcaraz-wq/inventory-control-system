{
  "name": "inventory-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo-data.ts",
    "db:seed-demo-data": "tsx scripts/seed-demo-data.ts",
    "db:seed-demo-stock-topup": "tsx scripts/seed-demo-stock-topup.ts",
    "db:rotate-passwords": "tsx scripts/rotate-seeded-passwords.ts",
    "db:test:setup": "tsx scripts/setup-test-db.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.2.1",
    "@react-pdf/renderer": "^4.6.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "2.4.3",
    "csv-stringify": "^6.8.3",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.23",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.2.1": true,
    "@prisma/engines@6.2.1": true,
    "prisma@6.2.1": true,
    "esbuild@0.28.2": true
  }
}
