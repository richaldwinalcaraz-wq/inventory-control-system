# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
# Local dev: both point at the same local Postgres. On Supabase/Vercel:
# DATABASE_URL = the pooled "Transaction pooler" connection string (port
# 6543, add ?pgbouncer=true) used at runtime; DIRECT_URL = the direct
# connection (port 5432), used only by `prisma migrate deploy` — Supabase's
# pooler doesn't support what Prisma Migrate needs. Both are on Supabase's
# Project Settings -> Database -> Connection string page, NOT the anon/
# service_role API keys (this app talks to Postgres directly via Prisma,
# it never uses the Supabase client SDK).
DATABASE_URL="postgresql://postgres:devlocal@localhost:5432/inventory_dev?schema=public"
DIRECT_URL="postgresql://postgres:devlocal@localhost:5432/inventory_dev?schema=public"

# --- Auth.js ---
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# --- Session / transaction PIN security (business-process-design.md G-30) ---
PIN_TOKEN_TTL_SECONDS=60
IDLE_LOCK_MINUTES=3

# --- Timezone (build-prompt.md engineering decision: store UTC, render Asia/Manila) ---
TIMEZONE="Asia/Manila"

# --- Daily hash-export job (architecture.md sec.5 / BR-012, G-27) ---
# Deferred until Redis/BullMQ is set up (Docker was skipped for now, see README).
# For now the chain-verification function is exercised on demand, not on a schedule.
HASH_EXPORT_SMTP_HOST=""
HASH_EXPORT_SMTP_PORT=""
HASH_EXPORT_SMTP_USER=""
HASH_EXPORT_SMTP_PASS=""
HASH_EXPORT_RECIPIENTS_OWNER=""
HASH_EXPORT_RECIPIENTS_AUDITOR=""

# --- Evidence photo storage (TransactionEvidence.storageKey) ---
# Local dev: "filesystem" (writes to ./storage/evidence). Production on
# Vercel: "vercel-blob" — auth is Vercel's platform-injected OIDC token
# (automatic, not something you set) plus BLOB_READ_WRITE_TOKEN_STORE_ID,
# which Vercel adds automatically once a Blob store is connected (Storage
# tab) — note it's that exact name, not a plain BLOB_READ_WRITE_TOKEN.
EVIDENCE_STORAGE_DRIVER="filesystem"
EVIDENCE_STORAGE_LOCAL_DIR="./.data/evidence"
